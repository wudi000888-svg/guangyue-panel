# Single source of truth for pinned third-party build inputs.
#
# Plain KEY=value lines only (no quotes, no expansion; an inline comment
# after whitespace is allowed): bash scripts source
# this file, while scripts/release-check.py, scripts/third-party.py and CI
# parse it. It ships inside release bundles with scripts/ so the corresponding
# source build scripts keep working there. Mentions that cannot read it
# (THIRD_PARTY_NOTICES.md, core-patches/README.md, systemd unit descriptions,
# deploy/install.py, deploy/docker/Dockerfile, scripts/build-docker.sh) are
# verified against it by scripts/release-check.py.

# Mihomo: unmodified official amd64-compatible binary plus GPL source archive.
MIHOMO_VERSION=v1.19.30
MIHOMO_COMMIT=ac017cdd246ce8bd547653d927e7bf77d7ee73d5
MIHOMO_BINARY_SHA256=8ad44e28fe72be4640254b96741b677f4074991b99186cc4486a1c28ded02b1a

# Xray-core: patched source build (core-patches/xray-user-sessions.patch).
# The release zip hash only applies to scripts/fetch-xray.sh in old source trees.
XRAY_VERSION=v26.3.27
XRAY_COMMIT=d2758a023cd7f4174a5a5fa4ff66e487d4342ba0
XRAY_RELEASE_ZIP_SHA256=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae # gitleaks:allow public upstream SHA256

# Hysteria 2: patched source build, upstream tag app/$HY2_VERSION.
HY2_VERSION=v2.9.2
HY2_COMMIT=c3a806b5cbbb20fe72099529573da26b1a2e9f22

# Images shipped in the Docker archive; CI services use the same references.
POSTGRES_IMAGE=postgres:17-bookworm@sha256:66aafa11cf15800a3c94763f7e11d1e7b2e37e5e84bc4ce027cb6e1e4bfaf4df
REDIS_IMAGE=redis:8-bookworm@sha256:a1da393d1b8099236b645f1471d2e93bcdcdcbbf7e829b38bcc9b71227f0a901

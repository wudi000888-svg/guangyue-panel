[Unit]
Description=Reconcile Guangyue native HY2 certificate

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/guangyue-updater/gateway_certificate.py
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/guangyue-updater
MemoryMax=64M
TasksMax=32
TimeoutStartSec=50

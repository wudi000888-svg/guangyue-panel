[Unit]
Description=Guangyue Panel Xray 26.3.27
After=network-online.target systemd-tmpfiles-setup.service guangyue.service
Wants=network-online.target

[Service]
Type=simple
User=guangyue
Group=guangyue
ExecStart=/opt/guangyue-personal/bin/guangyue -run-core xray
KillMode=control-group
TimeoutStopSec=15
Restart=always
RestartSec=1
Environment=GOMEMLIMIT=64MiB
Environment=GOMAXPROCS=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/guangyue-reality
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
MemoryHigh=128M
MemoryMax=256M
TasksMax=64
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target

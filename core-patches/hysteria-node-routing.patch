--- /dev/null
+++ b/app/cmd/node_outbounds_test.go
@@ -0,0 +1,44 @@
+package cmd
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/apernet/hysteria/core/v2/server"
+	"github.com/spf13/viper"
+)
+
+func TestNodeOutboundConfigAndUnknownIdentity(t *testing.T) {
+	v := viper.New()
+	v.SetConfigType("json")
+	if err := v.ReadConfig(strings.NewReader(`{"nodeRouting":true,"nodeOutbounds":{"hy2-main":{"name":"exit","type":"direct","direct":{"mode":4}},"hy2-proxy":{"name":"exit","type":"http","http":{"url":"http://127.0.0.1:8080"}}}}`)); err != nil {
+		t.Fatal(err)
+	}
+	var c serverConfig
+	if err := v.Unmarshal(&c); err != nil {
+		t.Fatal(err)
+	}
+	var config server.Config
+	if err := c.fillNodeOutbounds(&config); err != nil {
+		t.Fatal(err)
+	}
+	if config.OutboundForUser == nil {
+		t.Fatal("node routing was ignored")
+	}
+	a, b := config.OutboundForUser("u1.0.hash@hy2-main"), config.OutboundForUser("u1.0.hash@hy2-proxy")
+	if a == nil || b == nil || a == b {
+		t.Fatal("different nodes share the same outbound")
+	}
+	for _, id := range []string{"", "hy2-main", "@hy2-main", "u1@unknown", "u1@hy2-main@unknown"} {
+		if config.OutboundForUser(id) != nil {
+			t.Fatal("unknown identity fell back to an outbound")
+		}
+	}
+	c.NodeOutbounds = nil
+	if err := c.fillNodeOutbounds(&config); err != nil {
+		t.Fatal(err)
+	}
+	if config.OutboundForUser("u1@hy2-main") != nil {
+		t.Fatal("empty routing table failed open")
+	}
+}

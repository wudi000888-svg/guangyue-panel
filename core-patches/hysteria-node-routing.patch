+// Node routes use only the identity returned by the trusted authenticator.
+// The client cannot select a route independently of its node credential.
+func (c *serverConfig) fillNodeOutbounds(hyConfig *server.Config) error {
+	if !c.NodeRouting {
+		return nil
+	}
+	routes := make(map[string]server.Outbound, len(c.NodeOutbounds))
+	for node, entry := range c.NodeOutbounds {
+		if node == "" || strings.Contains(node, "@") {
+			return configError{Field: "nodeOutbounds", Err: errors.New("invalid node ID")}
+		}
+		candidate := &server.Config{}
+		cfg := serverConfig{Resolver: c.Resolver, Outbounds: []serverConfigOutboundEntry{entry}}
+		if err := cfg.fillOutboundConfig(candidate); err != nil {
+			return err
+		}
+		routes[node] = candidate.Outbound
+	}
+	hyConfig.OutboundForUser = func(id string) server.Outbound {
+		index := strings.LastIndexByte(id, '@')
+		if index <= 0 {
+			return nil
+		}
+		return routes[id[index+1:]]
+	}
+	return nil
+}

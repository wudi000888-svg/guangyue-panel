new file mode 100644
--- /dev/null
+++ b/core/internal/integration_tests/node_outbound_test.go
@@ -0,0 +1,126 @@
+package integration_tests
+
+import (
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/apernet/hysteria/core/v2/client"
+	"github.com/apernet/hysteria/core/v2/server"
+)
+
+type nodeTestAuth struct{}
+
+func (nodeTestAuth) Authenticate(_ net.Addr, auth string, _ uint64) (bool, string) { return true, auth }
+
+type nodeTestOutbound struct{ marker string }
+
+func (o *nodeTestOutbound) TCP(_ string) (net.Conn, error) {
+	a, b := net.Pipe()
+	go func() { defer b.Close(); _, _ = b.Write([]byte(o.marker)) }()
+	return a, nil
+}
+func (o *nodeTestOutbound) UDP(_ string) (server.UDPConn, error) {
+	return &nodeTestUDP{marker: o.marker, packets: make(chan string, 4), done: make(chan struct{})}, nil
+}
+func (o *nodeTestOutbound) CheckUDP(_ string) error { return nil }
+
+type nodeTestUDP struct {
+	marker  string
+	packets chan string
+	done    chan struct{}
+	once    sync.Once
+}
+
+func (u *nodeTestUDP) WriteTo(b []byte, addr string) (int, error) {
+	select {
+	case u.packets <- addr:
+		return len(b), nil
+	case <-u.done:
+		return 0, net.ErrClosed
+	}
+}
+func (u *nodeTestUDP) ReadFrom(b []byte) (int, string, error) {
+	select {
+	case addr := <-u.packets:
+		return copy(b, u.marker), addr, nil
+	case <-u.done:
+		return 0, "", net.ErrClosed
+	}
+}
+func (u *nodeTestUDP) Close() error { u.once.Do(func() { close(u.done) }); return nil }
+
+// Two concurrent clients use the same UDP listener but distinct authenticated
+// routes for both TCP streams and UDP datagrams. Unknown routes fail closed.
+func TestNodeOutboundIsolationTCPAndUDP(t *testing.T) {
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	routes := map[string]server.Outbound{"node-a": &nodeTestOutbound{"route-A"}, "node-b": &nodeTestOutbound{"route-B"}}
+	s, err := server.NewServer(&server.Config{TLSConfig: serverTLSConfig(), Conn: conn, Authenticator: nodeTestAuth{}, OutboundForUser: func(id string) server.Outbound { return routes[id] }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	go s.Serve()
+	clients := []client.Client{}
+	for _, id := range []string{"node-a", "node-b"} {
+		c, _, e := client.NewClient(&client.Config{ServerAddr: conn.LocalAddr(), Auth: id, TLSConfig: client.TLSConfig{InsecureSkipVerify: true}})
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer c.Close()
+		clients = append(clients, c)
+	}
+	for round := 0; round < 2; round++ {
+		for i, c := range clients {
+			want := []string{"route-A", "route-B"}[i]
+			tcp, e := c.TCP("target.invalid:443")
+			if e != nil {
+				t.Fatal(e)
+			}
+			_ = tcp.SetReadDeadline(time.Now().Add(5 * time.Second))
+			b := make([]byte, len(want))
+			_, e = io.ReadFull(tcp, b)
+			tcp.Close()
+			if e != nil || string(b) != want {
+				t.Fatalf("TCP route mismatch: %q %v", b, e)
+			}
+			udp, e := c.UDP()
+			if e != nil {
+				t.Fatal(e)
+			}
+			if e = udp.Send([]byte("probe"), "target.invalid:53"); e != nil {
+				t.Fatal(e)
+			}
+			result := make(chan error, 1)
+			go func() {
+				data, addr, e := udp.Receive()
+				if e == nil && (string(data) != want || addr != "target.invalid:53") {
+					e = errors.New("UDP route mismatch")
+				}
+				result <- e
+			}()
+			select {
+			case e = <-result:
+			case <-time.After(5 * time.Second):
+				e = errors.New("UDP timed out")
+			}
+			udp.Close()
+			if e != nil {
+				t.Fatal(e)
+			}
+		}
+	}
+	c, _, err := client.NewClient(&client.Config{ServerAddr: conn.LocalAddr(), Auth: "missing-node", TLSConfig: client.TLSConfig{InsecureSkipVerify: true}})
+	if c != nil {
+		c.Close()
+	}
+	if err == nil {
+		t.Fatal("unknown node authenticated through default route")
+	}
+}

--- /dev/null
+++ b/app/dispatcher/guangyue_sessions.go
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MPL-2.0
+// Guangyue extension: authenticated VLESS sessions, not unique source IPs.
+package dispatcher
+
+import (
+	"context"
+	"sync"
+
+	"github.com/xtls/xray-core/features/stats"
+)
+
+// Registration must be serialized: simultaneous first sessions for one user
+// can otherwise lose a count when GetOrRegisterCounter loses its insert race.
+var sessionRegistration sync.Mutex
+
+// TrackSession is called once by the VLESS inbound, before any mux dispatch.
+// Counting at this boundary prevents counting both a mux carrier and its flows.
+func TrackSession(ctx context.Context, manager stats.Manager, email string) {
+	if email == "" {
+		return
+	}
+	if ctx.Done() == nil {
+		return
+	}
+	sessionRegistration.Lock()
+	c, _ := stats.GetOrRegisterCounter(manager, "user>>>"+email+">>>connections")
+	sessionRegistration.Unlock()
+	if c == nil {
+		return
+	}
+	c.Add(1)
+	context.AfterFunc(ctx, func() { c.Add(-1) })
+}
